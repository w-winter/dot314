{
    "enforceCompactionMandatoryReading": false,
    "enforceBranchMandatoryReading": false,
    "includeFilesTouched": {
        "inCompactionSummary": "writer",
        "inBranchSummary": "writer"
    },
    "toolResultChars": 2000,
    "verbatimUserMessageTokens": null,
    "verbatimUserMessageFlagChars": 8000,
    "defaultPreset": "default",
    "largeContextPreset": "large",
    "presets": {
        "default": {
            "model": "anthropic/claude-opus-5",
            "thinkingLevel": "medium"
        },
        "cheap": {
            "model": "openai-codex/gpt-5.6-terra",
            "thinkingLevel": "high"
        },
        "large": {
            "model": "openai-codex/gpt-5.4",
            "thinkingLevel": "xhigh"
        },
        "deep": {
            "model": "anthropic/claude-opus-5",
            "thinkingLevel": "xhigh"
        }
    }
}
