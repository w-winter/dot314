{
  "name": "pi-skill-templates",
  "version": "0.1.4",
  "description": "Nunjucks-templated SKILL.template.md skills for Pi, rendered from invocation arguments, options, and flags, and composed from other skills",
  "keywords": ["pi-package", "pi", "pi-coding-agent", "skills", "templates", "nunjucks"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w-winter/dot314.git",
    "directory": "packages/pi-skill-templates"
  },
  "bugs": {
    "url": "https://github.com/w-winter/dot314/issues"
  },
  "homepage": "https://github.com/w-winter/dot314#readme",
  "pi": {
    "extensions": ["extensions/skill-templates/index.ts"]
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "nunjucks": "^3.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.79.1"
  },
  "scripts": {
    "prepack": "node ../../scripts/pi-package-prepack.mjs"
  },
  "files": ["extensions/**", "README.md", "LICENSE", "package.json"],
  "dot314Prepack": {
    "clean": ["extensions", "LICENSE"],
    "copy": [
      { "from": "../../extensions/skill-templates/args.ts", "to": "extensions/skill-templates/args.ts" },
      { "from": "../../extensions/skill-templates/catalog.ts", "to": "extensions/skill-templates/catalog.ts" },
      { "from": "../../extensions/skill-templates/index.ts", "to": "extensions/skill-templates/index.ts" },
      { "from": "../../extensions/skill-templates/render.ts", "to": "extensions/skill-templates/render.ts" },
      { "from": "../../extensions/skill-templates/types.ts", "to": "extensions/skill-templates/types.ts" },
      { "from": "../../LICENSE", "to": "LICENSE" }
    ]
  }
}
