{
  "name": "pi-claude-bridge-local",
  "private": true,
  "description": "Local Pi provider bridge that runs Claude Code through the Claude Agent SDK.",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@anthropic-ai/sdk": "^0.112.4",
    "cc-session-io": "^0.3.2",
    "change-case": "^5.4.4",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.86.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.0",
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/node": "^24.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test:unit": "node --import tsx --import ./tests/lib/test-env.mjs --test tests/unit-*.mjs",
    "check:exports": "! grep -rnE '^export (let|var) ' src",
    "test:ci": "npm run typecheck && npm run check:exports && npm run test:unit",
    "test": "set -a && [ -f .env.test ] && . ./.env.test; set +a && npm run test:unit && tests/int-smoke.sh && tests/int-multi-turn.sh && tests/int-cache.sh && node --import tsx --test tests/int-*.mjs",
    "test:usage": "tests/usage-test.sh",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
