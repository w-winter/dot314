{
  "name": "dot314",
  "version": "0.5.9",
  "private": true,
  "description": "Collection of original and modded Pi extensions, several of which facilitate Pi's integration with RepoPrompt.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "repoprompt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w-winter/dot314.git"
  },
  "bugs": {
    "url": "https://github.com/w-winter/dot314/issues"
  },
  "homepage": "https://github.com/w-winter/dot314#readme",
  "scripts": {
    "build:repoprompt-mcp": "tsc -p extensions/repoprompt-mcp/tsconfig.json",
    "watch:repoprompt-mcp": "tsc -p extensions/repoprompt-mcp/tsconfig.json --watch",
    "test:repoprompt-mcp": "npm run build:repoprompt-mcp && node --test extensions/repoprompt-mcp/test/*.test.js"
  },
  "pi": {
    "extensions": [
      "./extensions/anycopy/index.ts",
      "./extensions/branch-out/index.ts",
      "./extensions/command-center/index.ts",
      "./extensions/editor-enhancements/index.ts",
      "./extensions/ephemeral-mode.ts",
      "./extensions/files-touched.ts",
      "./extensions/fork-from-first.ts",
      "./extensions/grounded-compaction/index.ts",
      "./extensions/handover/index.ts",
      "./extensions/image-url-broker/index.ts",
      "./extensions/protect-paths/index.ts",
      "./extensions/md.ts",
      "./extensions/assistant-provenance/index.ts",
      "./extensions/model-aware-compaction/index.ts",
      "./extensions/model-sysprompt-appendix/index.ts",
      "./extensions/move-session.ts",
      "./extensions/pi-codex-goal/src/index.ts",
      "./extensions/pi-queue-steer/index.ts",
      "./extensions/repoprompt-mcp/src/index.ts",
      "./extensions/reverse-thinking.ts",
      "./extensions/sandbox/index.ts",
      "./extensions/session-ask/index.ts",
      "./extensions/session-switch/index.ts",
      "./extensions/screenshots-picker/index.ts",
      "./extensions/skill-templates/index.ts",
      "./extensions/stash/index.ts",
      "./extensions/tool-horizon/index.ts",
      "./extensions/tools/index.ts",
      "./extensions/usage-bar.ts"
    ],
    "skills": [],
    "prompts": [
      "./extensions/pi-codex-goal/prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.26",
    "@mariozechner/clipboard": "*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@mozilla/readability": "^0.5.0",
    "diff": "^7.0.0",
    "glob": "^13.0.6",
    "ignore": "^7.0.5",
    "jsdom": "^26.0.0",
    "just-bash": "^2.10.0",
    "nunjucks": "^3.2.4",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.0",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": ">=0.86.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
